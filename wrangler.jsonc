// Cloudflare Worker that serves the site (built with OpenNext: npm run deploy).
// "name" must match the Worker's name in the Cloudflare dashboard, or Cloudflare's Git builds fail.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chrome-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "chrome-portfolio" }
  ],
  "observability": { "enabled": true }
}
